<h2>لوحة تحكم الأدمن</h2>
<table border="1">
  <thead>
    <tr>
      <th>اسم المستخدم</th>
      <th>البريد الإلكتروني</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<a href="/admin/logout">تسجيل الخروج</a>
