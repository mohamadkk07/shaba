<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>مقاطع <%= username %></title>
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f7f9fc;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        h1 {
            text-align: center;
            margin-bottom: 10px;
            color: #00509e;
        }

        .back-link {
            text-align: center;
            margin-bottom: 30px;
        }

        .back-link a {
            text-decoration: none;
            color: #00509e;
            font-weight: bold;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            justify-content: center;
            padding: 0 10px;
        }

        .clip-card {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            overflow: hidden;
            transition: transform 0.3s ease;
            text-align: center;
            padding: 10px;
        }

        .clip-card:hover {
            transform: translateY(-5px);
        }

        .clip-card video {
            width: 100%;
            height: auto;
            border-radius: 6px;
        }

        .clip-card p {
            margin-top: 10px;
            font-size: 13px;
            color: #666;
        }

        .no-clips {
            text-align: center;
            font-size: 18px;
            color: #888;
            margin-top: 50px;
        }
    </style>
</head>
<body>
    <h1>مقاطع <%= username %></h1>

    <div class="back-link">
        <a href="/">⟵ العودة للصفحة الرئيسية</a>
    </div>

    <% if (clips.length === 0) { %>
        <p class="no-clips">لا يوجد مقاطع حتى الآن.</p>
    <% } else { %>
        <div class="video-grid">
            <% clips.forEach(clip => { %>
                <div class="clip-card">
                    <video controls>
                        <source src="/clips/cut/<%= clip.filename %>" type="video/mp4">
                        المتصفح لا يدعم الفيديو.
                    </video>
                    <p>تم الإنشاء في: <%= new Date(clip.createdAt).toLocaleDateString('ar-EG', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
            <% }); %>
        </div>
    <% } %>
</body>
</html>
