<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>قائمة المستخدمين</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            direction: rtl;
            background-color: #f2f2f2;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #333;
        }
        table {
            width: 100%;
            max-width: 900px;
            margin: auto;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0 0 10px #ccc;
        }
        th, td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: center;
        }
        th {
            background-color: #4CAF50;
            color: white;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-weight: bold;
            color: #4CAF50;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <h1>جميع المستخدمين المسجلين</h1>

   <table>
    <thead>
        <tr>
            <th>المعرف</th>
            <th>اسم المستخدم</th>
            <th>البريد الإلكتروني</th>
            <th>كلمة المرور</th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email || '---' %></td> <!-- إذا كان البريد الإلكتروني فارغًا، يظهر '---' -->
                <td><%= user.password || '---' %></td> <!-- إذا كانت كلمة المرور فارغة، يظهر '---' -->
            </tr>
        <% }) %>
    </tbody>
</table>

    <a href="/" class="back-link">الرجوع للصفحة الرئيسية</a>
</body>
</html>
