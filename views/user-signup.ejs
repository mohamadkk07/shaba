<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>إنشاء حساب جديد</title>
  <style>
    body { font-family: sans-serif; background: #f0f0f0; display: flex; justify-content: center; align-items: center; height: 100vh; }
    form { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 0 10px #ccc; width: 300px; }
    input { width: 100%; padding: 10px; margin-bottom: 15px; border-radius: 8px; border: 1px solid #ccc; }
    button { width: 100%; padding: 10px; background: #28a745; color: white; border: none; border-radius: 8px; cursor: pointer; }
    button:hover { background: #218838; }
    .login-link {
      margin-top: 10px;
      display: block;
      text-align: center;
      color: #28a745;
      text-decoration: none;
    }
    .login-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <form method="POST" action="/user/signup">
    <h3>📝 إنشاء حساب</h3>
        <label for="username">اسم المستخدم</label>
    <input type="text" name="username" id="username" required>
    
    <label for="email">البريد الإلكتروني</label>
    <input type="email" name="email" id="email" required>

    <label for="password">كلمة المرور</label>
    <input type="password" name="password" id="password" required>
    
    <button type="submit">تسجيل</button>
    
    <a class="login-link" href="/user/login">لديك حساب بالفعل؟ تسجيل الدخول</a>
  </form>
</body>
</html>
